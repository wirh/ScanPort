{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "ScanPort: build (debug)",
            "type": "shell",
            "command": "${workspaceFolder}\\build.bat",
            "args": ["debug"],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "SCANPORT_NO_PAUSE": "1"
                }
            },
            "problemMatcher": "$gcc",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "ScanPort: build (release)",
            "type": "shell",
            "command": "${workspaceFolder}\\build.bat",
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "SCANPORT_NO_PAUSE": "1"
                }
            },
            "problemMatcher": "$gcc"
        }
    ]
}
